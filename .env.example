# Template konfigurasi AelfLab Hub.
#
# Hub membaca nilai berikut dari environment variable, dan kalau tidak ada,
# dari file .env milik Hermes ($HERMES_HOME/.env — default D:\homelab\hermes\.env).
#
# JANGAN commit file .env yang sudah terisi.

# Lokasi instalasi Hermes. Dipakai untuk cron manager dan pembacaan .env.
HERMES_HOME=D:/homelab/hermes

# Saldo DeepSeek di dashboard. Kalau kosong, kartu saldo tampil "—".
DEEPSEEK_API_KEY=

# Notifikasi hasil cron run. Kalau salah satu kosong, notifikasi dilewati
# dan alasannya dicatat di log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Override lokasi database finance (opsional, dipakai backend/clean_db.py).
# Default: <hub>/data/finance.db
# FINANCE_DB=D:/homelab/hermes-workspace/hub/data/finance.db
